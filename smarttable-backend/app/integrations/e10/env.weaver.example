# ============================================================
# 泛微 E10 接入示例（app.weaver.com.cn:20600）
#
# E10 账号映射规则：人员id
# 自定义属性：username=姓名，job_num=工号，mobile=手机号
#
# 使用方式：把需要的行合并到 config/.env（或 Docker 环境变量），
# 替换 client_id / client_secret / SmartTable 地址后重启后端。
# ============================================================

E10_SSO_ENABLED=true

# E10 根地址（不要带尾部 /）
E10_BASE_URL=http://app.weaver.com.cn:20600

# E10 统一认证中心 -> 认证应用管理 中注册应用后获得
E10_CLIENT_ID=请替换为E10应用标识
E10_CLIENT_SECRET=请替换为E10应用密钥

# SmartTable 对外地址：必须与 E10 应用登记的业务系统 URL 完全一致，且不能带 #
# 注意：E10 当前是 HTTP，SmartTable 回调也建议使用 HTTP；若 SmartTable 使用 HTTPS，
# 请确认 E10 允许该回调协议（E10 文档要求两侧协议保持一致）。
E10_REDIRECT_URI=http://192.168.1.100:5000/api/integrations/e10/callback
E10_FRONTEND_BASE_URL=http://192.168.1.100:5000

# 账号映射规则 = 人员id；/profile 返回的 id 就是人员 id
E10_ID_FIELD=id

# SmartTable 的 users.email 是必填唯一字段。
# 优先级：E10 attributes.email > profile.id 本身是邮箱 > E10_EMAIL_TEMPLATE > E10_EMAIL_FALLBACK_TEMPLATE。
# 如果 E10 已增加自定义属性 email，集成会自动优先使用它；
# 下面两条仅在 email 缺失时作为兜底（工号派生内部邮箱，工号缺失再用人员 id）。
E10_EMAIL_TEMPLATE={job_num}@e10.local
E10_EMAIL_FALLBACK_TEMPLATE={id}@e10.local

# 首次登录自动开通用户；默认角色 editor（可选 viewer / commenter / editor）
E10_AUTO_CREATE_USERS=true
E10_DEFAULT_ROLE=editor

# 按派生邮箱匹配已有 SmartTable 用户；若已有用户邮箱不是 {job_num}@... 形式，
# 需要手工调整用户邮箱，或先关闭自动匹配/自动开通，改为预先建好用户。
E10_MATCH_BY_EMAIL=true

# 姓名同步：使用 E10 自定义属性 username
E10_SYNC_PROFILE=true

# 管理员白名单：可填 E10 人员 id，也可填工号（本集成会自动识别两者）
# E10_ADMIN_IDS=A1001,A1002

# 是否保留 SmartTable 本地账号密码登录
E10_PASSWORD_LOGIN_ENABLED=true
# 是否在服务端强制只允许 E10 登录（确认 SSO 可用、且已有 admin 账号后再开启）
E10_ENFORCE_SSO=false

# 退出时注销 E10 会话
E10_LOGOUT_WITH_E10=true

# E10 接口参数位置：auto（先 query，失败再 form）/ query / form
E10_TOKEN_PARAM_STYLE=auto
E10_PROFILE_PARAM_STYLE=query

# E10 当前是 HTTP，TLS 校验配置不生效；若以后切 HTTPS 可保留默认
E10_VERIFY_SSL=true
