# ============================================================
# 泛微 E10 OAuth2 单点登录配置示例
# 复制到 config/.env 或容器环境变量中，按实际环境修改
# ============================================================

# 总开关（false 时登录按钮隐藏，所有 E10 路由返回未启用）
E10_SSO_ENABLED=true

# E10 地址（协议必须与 SmartTable 一致；不要以 / 结尾）
E10_BASE_URL=https://oa.example.com

# E10 统一认证中心 -> 认证应用管理 中注册应用后获得
E10_CLIENT_ID=your-client-id
E10_CLIENT_SECRET=your-client-secret

# OAuth2 回调地址：必须是 E10 中登记的业务系统 URL，且不能带 # 路由
# 前后端同源部署时通常为：https://smarttable.example.com/api/integrations/e10/callback
E10_REDIRECT_URI=https://smarttable.example.com/api/integrations/e10/callback

# 前端访问地址（登录完成后跳回 /#/e10-callback）
# 不配置时自动取 E10_REDIRECT_URI 的 origin
E10_FRONTEND_BASE_URL=https://smarttable.example.com

# 可选：反向代理场景下用于拼接回调地址的对外地址
# E10_PUBLIC_BASE_URL=https://smarttable.example.com

# ---------------- 账号映射 ----------------
# E10「账号映射规则」选择的字段。仅用于说明/排错，实际以 /profile 返回的 id 为准。
# 推荐在 E10 中选择「电子邮箱」，此时 id 就是邮箱，无需额外配置。
E10_ID_FIELD=loginId

# 当 id 不是邮箱时，用域名拼接邮箱：{id}@corp.example.com
E10_EMAIL_DOMAIN=corp.example.com
# 或使用完整模板（优先级高于 E10_EMAIL_DOMAIN，支持 {id}/{job_num}/{username}/{mobile}/{domain}）
# E10_EMAIL_TEMPLATE={id}@corp.example.com
# 模板渲染失败（如工号为空）时的回退模板
# E10_EMAIL_FALLBACK_TEMPLATE={id}@corp.example.com

# 首次登录时自动创建 SmartTable 用户（生产环境可按需关闭）
E10_AUTO_CREATE_USERS=true

# 自动创建用户的默认角色：viewer / commenter / editor
# 管理角色只能通过 E10_ADMIN_IDS 显式指定
E10_DEFAULT_ROLE=editor

# E10 id 白名单 -> SmartTable admin（逗号分隔，谨慎配置）
# E10_ADMIN_IDS=zhangsan,lisi

# 按邮箱匹配已有 SmartTable 用户（推荐开启）
E10_MATCH_BY_EMAIL=true

# 每次登录同步 E10 返回的姓名/头像（E10 当前 attributes 为空则不会覆盖）
E10_SYNC_PROFILE=true

# ---------------- 登录页 / 登出 ----------------
# 是否保留 SmartTable 账号密码登录（仅隐藏前端表单）
E10_PASSWORD_LOGIN_ENABLED=true

# 是否在服务端强制只允许 E10 登录（会禁用 /api/auth/login 与 /api/auth/register）
# 注意：请先确认 E10 登录可用，并保留至少一个 admin 账号，否则可能无法进入管理页
E10_ENFORCE_SSO=false

# SmartTable 退出时是否同时注销 E10 会话
E10_LOGOUT_WITH_E10=true

# 可选：E10 退出后跳回的地址（必须加入 E10 白名单）
# E10_LOGOUT_SERVICE=https://smarttable.example.com/#/login

# ---------------- 高级选项 ----------------
# E10 接口参数位置：auto（默认，先 query 后 form）/ query / form
E10_TOKEN_PARAM_STYLE=auto
E10_PROFILE_PARAM_STYLE=query
# 是否把 state 放进授权 URL（额外参数）；E10 若严格校验参数可设为 false，
# 此时仍会通过 HttpOnly Cookie 校验 state
E10_SEND_STATE=true
E10_TIMEOUT=15
E10_VERIFY_SSL=true
# E10_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem

# OAuth state / 一次性票据有效期（秒）
E10_STATE_TTL=600
E10_TICKET_TTL=120

# state Cookie 的 SameSite：Lax（默认）/ Strict / None
# 仅当 SmartTable 被嵌入 E10 门户 iframe、且 Cookie 被浏览器拦截时，才改为 None（必须 HTTPS）
E10_COOKIE_SAMESITE=Lax
# Cookie Secure：auto（按请求协议）/ true / false
E10_COOKIE_SECURE=auto
# 登录票据绑定 Cookie 名称（一般无需修改）
# E10_BINDING_COOKIE_NAME=e10_login_binding

# 自动创建 e10_sso_identities 表（默认 true；如由 DBA 手工建表可设为 false）
E10_AUTO_CREATE_SCHEMA=true
