  "cat": {
    "math": "数学",
    "text": "文本",
    "date": "日期",
    "logic": "逻辑",
    "stats": "统计"
  },
  "f": {
    "SUM": { "desc": "计算所有数值参数的和", "returns": "数字（求和结果）", "example": "SUM({单价}, {数量}) 或 SUM(10, 20, 30)", "p0": "要相加的数值或字段引用，支持任意数量参数" },
    "AVG": { "desc": "计算所有数值参数的平均值", "returns": "数字（平均值）", "example": "AVG({数学成绩}, {英语成绩}, {语文成绩})", "p0": "要计算平均值的数值，跳过空值" },
    "MAX": { "desc": "返回一组数值中的最大值", "returns": "最大值（数字或其他可比较类型）", "example": "MAX({一月销量}, {二月销量}, {三月销量})", "p0": "要比较的数值" },
    "MIN": { "desc": "返回一组数值中的最小值", "returns": "最小值", "example": "MIN({最低温度}, {最高温度})", "p0": "要比较的数值" },
    "ROUND": { "desc": "将数值四舍五入到指定位数", "returns": "四舍五入后的数字", "example": "ROUND(3.14159, 2) → 3.14", "p0": "要四舍五入的数值", "p1": "保留的小数位数，默认为 0" },
    "ABS": { "desc": "返回数值的绝对值", "returns": "非负数字", "example": "ABS(-10) → 10", "p0": "要取绝对值的数值" },
    "CEILING": { "desc": "向上取整到最接近的整数", "returns": "整数", "example": "CEILING(3.2) → 4", "p0": "要向上取整的数值" },
    "FLOOR": { "desc": "向下取整到最接近的整数", "returns": "整数", "example": "FLOOR(3.8) → 3", "p0": "要向下取整的数值" },
    "POWER": { "desc": "计算数值的幂次方", "returns": "数字（base 的 exponent 次方）", "example": "POWER(2, 3) → 8", "p0": "底数", "p1": "指数" },
    "SQRT": { "desc": "计算数值的平方根", "returns": "数字（平方根）", "example": "SQRT(16) → 4", "p0": "非负数值" },
    "MOD": { "desc": "返回两数相除的余数", "returns": "数字（余数）", "example": "MOD(10, 3) → 1", "p0": "被除数", "p1": "除数" },
    "LN": { "desc": "计算数值的自然对数（以 e 为底）", "returns": "数字（自然对数）", "example": "LN(2.718) → 1", "p0": "正数" },
    "LOG": { "desc": "计算数值的对数", "returns": "数字（对数）", "example": "LOG(100, 10) → 2", "p0": "正数", "p1": "对数的底数，默认为 10" },
    "EXP": { "desc": "计算 e 的指定次幂", "returns": "数字（e^value）", "example": "EXP(1) → 2.718...", "p0": "指数值" },
    "PI": { "desc": "返回圆周率 π 的值", "returns": "数字（约 3.14159）", "example": "PI() → 3.14159..." },
    "E": { "desc": "返回自然常数 e 的值", "returns": "数字（约 2.71828）", "example": "E() → 2.71828..." },
    "RAND": { "desc": "返回 [0, 1) 区间的随机数", "returns": "数字（0 <= x < 1）", "example": "RAND() → 0.428..." },
    "RANDBETWEEN": { "desc": "返回指定区间内的随机整数", "returns": "整数", "example": "RANDBETWEEN(1, 100) → 42", "p0": "最小值（包含）", "p1": "最大值（包含）" },
    "CONCAT": { "desc": "拼接多个文本字符串", "returns": "字符串", "example": "CONCAT({姓}, {名}) → \"张三\"", "p0": "要拼接的文本值" },
    "UPPER": { "desc": "将文本转换为大写", "returns": "字符串（大写）", "example": "UPPER(\"hello\") → \"HELLO\"", "p0": "要转换的文本" },
    "LOWER": { "desc": "将文本转换为小写", "returns": "字符串（小写）", "example": "LOWER(\"HELLO\") → \"hello\"", "p0": "要转换的文本" },
    "LEN": { "desc": "返回文本的字符数", "returns": "整数", "example": "LEN(\"Hello\") → 5", "p0": "要计算长度的文本" },
    "TRIM": { "desc": "移除文本首尾的空白字符", "returns": "字符串", "example": "TRIM(\"  hello  \") → \"hello\"", "p0": "要修剪的文本" },
    "LEFT": { "desc": "从文本左侧提取指定数量的字符", "returns": "字符串", "example": "LEFT(\"Hello\", 2) → \"He\"", "p0": "源文本", "p1": "要提取的字符数" },
    "RIGHT": { "desc": "从文本右侧提取指定数量的字符", "returns": "字符串", "example": "RIGHT(\"Hello\", 2) → \"lo\"", "p0": "源文本", "p1": "要提取的字符数" },
    "MID": { "desc": "从文本中间提取指定数量的字符", "returns": "字符串", "example": "MID(\"Hello\", 2, 3) → \"ell\"", "p0": "源文本", "p1": "起始位置（从 1 开始）", "p2": "要提取的字符数" },
    "REPLACE": { "desc": "替换文本中指定位置的字符", "returns": "字符串", "example": "REPLACE(\"Hello\", 2, 2, \"aa\") → \"Haalo\"", "p0": "源文本", "p1": "起始位置（从 1 开始）", "p2": "要替换的字符数", "p3": "替换文本" },
    "SUBSTITUTE": { "desc": "替换文本中的指定子串", "returns": "字符串", "example": "SUBSTITUTE(\"hello hello\", \"hello\", \"hi\") → \"hi hi\"", "p0": "源文本", "p1": "要替换的子串", "p2": "替换为的文本", "p3": "替换第几次出现（可选，默认全部替换）" },
    "FIND": { "desc": "查找子串在文本中的位置", "returns": "整数（位置，未找到返回 0）", "example": "FIND(\"l\", \"Hello\") → 3", "p0": "要查找的子串", "p1": "源文本", "p2": "起始位置（可选，默认为 1）" },
    "REPT": { "desc": "重复文本指定次数", "returns": "字符串", "example": "REPT(\"*\", 5) → \"*****\"", "p0": "要重复的文本", "p1": "重复次数" },
    "TEXT": { "desc": "将数值格式化为文本", "returns": "字符串", "example": "TEXT(1234.5, \"#,##0.00\") → \"1,234.50\"", "p0": "要格式化的数值", "p1": "格式字符串，如 \"0.00\"、\"#,##0\"" },
    "VALUE": { "desc": "将文本转换为数值", "returns": "数字", "example": "VALUE(\"123.45\") → 123.45", "p0": "表示数值的文本" },
    "NOW": { "desc": "返回当前日期和时间", "returns": "日期时间", "example": "NOW() → 2026-07-17 09:30:00" },
    "TODAY": { "desc": "返回当前日期（不含时间）", "returns": "日期", "example": "TODAY() → 2026-07-17" },
    "YEAR": { "desc": "从日期中提取年份", "returns": "整数（年份）", "example": "YEAR({创建日期}) → 2026", "p0": "日期值或字段引用" },
    "MONTH": { "desc": "从日期中提取月份（1-12）", "returns": "整数（1-12）", "example": "MONTH({创建日期}) → 7", "p0": "日期值或字段引用" },
    "DAY": { "desc": "从日期中提取日（1-31）", "returns": "整数（1-31）", "example": "DAY({创建日期}) → 17", "p0": "日期值或字段引用" },
    "HOUR": { "desc": "从日期时间中提取小时（0-23）", "returns": "整数（0-23）", "example": "HOUR(NOW()) → 9", "p0": "日期时间值" },
    "MINUTE": { "desc": "从日期时间中提取分钟（0-59）", "returns": "整数（0-59）", "example": "MINUTE(NOW()) → 30", "p0": "日期时间值" },
    "SECOND": { "desc": "从日期时间中提取秒（0-59）", "returns": "整数（0-59）", "example": "SECOND(NOW()) → 45", "p0": "日期时间值" },
    "WEEKDAY": { "desc": "返回日期对应的星期几（1=周日，7=周六）", "returns": "整数（1-7）", "example": "WEEKDAY(TODAY()) → 6（周五）", "p0": "日期值" },
    "DATEADD": { "desc": "在日期上添加指定时间单位", "returns": "日期", "example": "DATEADD(TODAY(), 7, \"day\") → 一周后的日期", "p0": "起始日期", "p1": "要添加的数量（可为负数）", "p2": "时间单位：\"day\"、\"month\"、\"year\"、\"hour\"、\"minute\"、\"second\"" },
    "DATEDIF": { "desc": "计算两个日期之间的差值", "returns": "整数（差值）", "example": "DATEDIF({开始日期}, {结束日期}, \"day\") → 天数差", "p0": "起始日期", "p1": "结束日期", "p2": "时间单位：\"day\"、\"month\"、\"year\"" },
    "DATEDIFF": { "desc": "计算两个日期之间的差值（同 DATEDIF）", "returns": "整数（差值）", "example": "DATEDIFF({创建时间}, NOW(), \"hour\") → 小时差", "p0": "起始日期", "p1": "结束日期", "p2": "时间单位" },
    "DATETIME_FORMAT": { "desc": "按指定格式格式化日期时间", "returns": "字符串", "example": "DATETIME_FORMAT(NOW(), \"YYYY年MM月DD日\")", "p0": "日期时间值", "p1": "格式字符串，如 \"YYYY-MM-DD HH:mm:ss\"" },
    "FROMUNIXTIME": { "desc": "将 Unix 时间戳转换为日期时间", "returns": "日期时间", "example": "FROMUNIXTIME(1640995200) → 2021-12-31...", "p0": "Unix 时间戳（秒）" },
    "UNIXTIMESTAMP": { "desc": "将日期时间转换为 Unix 时间戳", "returns": "整数（Unix 时间戳）", "example": "UNIXTIMESTAMP(NOW()) → 1721187000", "p0": "日期时间值" },
    "IF": { "desc": "根据条件返回不同的值", "returns": "根据条件返回对应的值", "example": "IF({分数} >= 60, \"及格\", \"不及格\")", "p0": "条件表达式", "p1": "条件为真时返回的值", "p2": "条件为假时返回的值" },
    "IFS": { "desc": "多条件判断，返回第一个为真的条件对应的值", "returns": "匹配条件的值", "example": "IFS({分数}>=90, \"A\", {分数}>=80, \"B\", {分数}>=60, \"C\", \"D\")", "p0": "成对的条件和返回值" },
    "SWITCH": { "desc": "多值匹配，根据表达式值返回对应结果", "returns": "匹配的结果", "example": "SWITCH({状态}, \"待处理\", \"⏳\", \"进行中\", \"🔄\", \"已完成\", \"✅\", \"DEFAULT\", \"?\")", "p0": "要匹配的表达式", "p1": "值和结果的成对参数", "p2": "默认结果（可选）" },
    "AND": { "desc": "逻辑与，所有条件都为真时返回 TRUE", "returns": "TRUE 或 FALSE", "example": "AND({分数} >= 60, {出勤率} >= 0.8)", "p0": "要检查的条件" },
    "OR": { "desc": "逻辑或，任一条件为真时返回 TRUE", "returns": "TRUE 或 FALSE", "example": "OR({等级} = \"A\", {等级} = \"B\")", "p0": "要检查的条件" },
    "NOT": { "desc": "逻辑非，取反条件结果", "returns": "TRUE 或 FALSE", "example": "NOT(ISBLANK({备注}))", "p0": "要取反的条件" },
    "XOR": { "desc": "异或，仅当恰好一个条件为真时返回 TRUE", "returns": "TRUE 或 FALSE", "example": "XOR({是否会员}, {是否有优惠})", "p0": "第一个条件", "p1": "第二个条件" },
    "ISBLANK": { "desc": "判断值是否为空", "returns": "TRUE 或 FALSE", "example": "ISBLANK({备注})", "p0": "要检查的值" },
    "ISERROR": { "desc": "判断值是否为错误", "returns": "TRUE 或 FALSE", "example": "ISERROR(1/0) → TRUE", "p0": "要检查的值" },
    "ISNUMBER": { "desc": "判断值是否为数字", "returns": "TRUE 或 FALSE", "example": "ISNUMBER({年龄})", "p0": "要检查的值" },
    "ISTEXT": { "desc": "判断值是否为文本", "returns": "TRUE 或 FALSE", "example": "ISTEXT({姓名})", "p0": "要检查的值" },
    "ISDATE": { "desc": "判断值是否为日期", "returns": "TRUE 或 FALSE", "example": "ISDATE({创建时间})", "p0": "要检查的值" },
    "BLANK": { "desc": "返回空值", "returns": "NULL", "example": "IF({分数} = 0, BLANK(), {分数})" },
    "COUNT": { "desc": "计算数值参数的个数", "returns": "整数", "example": "COUNT({成绩1}, {成绩2}, {成绩3})", "p0": "要计数的数值" },
    "COUNTA": { "desc": "计算非空参数的个数", "returns": "整数", "example": "COUNTA({字段1}, {字段2}, {字段3})", "p0": "要计数的值" },
    "COUNTBLANK": { "desc": "计算空值参数的个数", "returns": "整数", "example": "COUNTBLANK({字段1}, {字段2}, {字段3})", "p0": "要检查的值" },
    "STDEV": { "desc": "计算样本标准差", "returns": "数字", "example": "STDEV({成绩1}, {成绩2}, {成绩3})", "p0": "样本数据" },
    "VAR": { "desc": "计算样本方差", "returns": "数字", "example": "VAR({成绩1}, {成绩2}, {成绩3})", "p0": "样本数据" },
    "MEDIAN": { "desc": "计算中位数", "returns": "数字", "example": "MEDIAN({成绩1}, {成绩2}, {成绩3})", "p0": "数值数据" },
    "MODE": { "desc": "计算众数（出现次数最多的值）", "returns": "数字", "example": "MODE(1, 2, 2, 3, 3, 3) → 3", "p0": "数值数据" },
    "RANK": { "desc": "计算数值在一组数值中的排名", "returns": "整数（排名）", "example": "RANK({分数}, {分数1}, {分数2}, {分数3})", "p0": "要排名的数值", "p1": "用于排名的一组数值" },
    "UNIQUE": { "desc": "返回去重后的数组", "returns": "数组", "example": "UNIQUE(1, 2, 2, 3, 3) → [1, 2, 3]", "p0": "要去重的值" }
  }
}
